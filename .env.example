# Frontend environment variables — copy to `.env` or `.env.local` and fill in
# real values. Both are git-ignored and must never be committed.
#
# THE DEPLOYED VALUES ARE SET IN THE VERCEL DASHBOARD, NOT HERE.
# Vercel does not read .env.local, and .env.production is git-ignored too, so
# nothing committed to this repository reaches the deployed frontend. What
# Vercel needs, under Settings -> Environment Variables, for Production and
# Preview:
#
#   VITE_API_URL = https://fanhubplus-api.onrender.com/api
#
# That hostname is the `name:` of the API service in render.yaml. Rename the
# service and this value must change with it. It ends in /api because the
# controllers are routed "api/[controller]" — without it every request is a 404.

# Base URL of the ASP.NET Core API
# The port MUST match backend/src/FanHubPlus.Api/Properties/launchSettings.json.
VITE_API_URL=http://localhost:5068/api

# Public map provider key (for location-aware event discovery)
VITE_MAP_API_KEY=

# AI chatbot key (optional feature — leave empty until built)
VITE_CHATBOT_API_KEY=

# Pexels API key — build-time only.
#
# NOT prefixed VITE_ on purpose. Anything with that prefix is inlined into the
# client bundle at build time, so VITE_PEXELS_API_KEY would be readable by
# anyone who opens devtools. scripts/fetchCosplayImages.mjs runs in Node, so a
# plain process.env lookup is what it does.
#
# Free tier: 25,000 requests an hour with a tighter burst limit. The script
# backs off on 429 and caches results, so a re-run costs nothing. Leave empty to
# skip fetching entirely; cards then render without an image.
PEXELS_API_KEY=

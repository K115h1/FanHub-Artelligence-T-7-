# Frontend environment variables — copy to `.env` and fill in real values.
# The real `.env` file is git-ignored and must never be committed.

# Base URL of the ASP.NET Core API
# The port MUST match backend/src/FanHubPlus.Api/Properties/launchSettings.json.
VITE_API_URL=http://localhost:5068/api

# Public map provider key (for location-aware event discovery)
VITE_MAP_API_KEY=

# AI chatbot key (optional feature — leave empty until built)
VITE_CHATBOT_API_KEY=

# Pexels API key — build-time only.
#
# NOT prefixed VITE_ on purpose. Anything with that prefix is inlined into the
# client bundle at build time, so VITE_PEXELS_API_KEY would be readable by
# anyone who opens devtools. scripts/fetchCosplayImages.mjs runs in Node, so a
# plain process.env lookup is what it does.
#
# Free tier: 200 requests per hour. The script makes 100 and caches results, so
# re-runs do not repeat them. Leave empty to skip fetching entirely; cards then
# render without an image.
PEXELS_API_KEY=

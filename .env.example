# Frontend environment variables — copy to `.env` and fill in real values.
# The real `.env` file is git-ignored and must never be committed.

# Base URL of the ASP.NET Core API
VITE_API_URL=http://localhost:5000/api

# Public map provider key (for location-aware event discovery)
VITE_MAP_API_KEY=

# AI chatbot key (optional feature — leave empty until built)
VITE_CHATBOT_API_KEY=
